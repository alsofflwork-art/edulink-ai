# Copy to `.env` (git-ignored) to enable live AI homework generation.
# Leave everything blank to run the demo on its simulated data layer only.
#
# Any OpenAI-compatible /v1/chat/completions endpoint works. Never commit
# real hosts or keys: .env stays on your machine.

# --- Kimi: homework generation ---
KIMI_BASE_URL=
KIMI_API_KEY=
KIMI_MODEL_NAME=

# --- Qwen: reserved for Arabic-English translation (not wired yet) ---
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL_NAME=
